@using System.Globalization

@if (Plan.Sections.Count == 0 || Plan.RollWidth <= 0 || Plan.RollLengthUsed <= 0)
{
    <p class="text-muted mb-0">Nothing to draw — no boxes to wrap.</p>
}
else
{
    <figure class="wrap-diagram mb-0">
        @* Drawn in the plan's own coordinates: X across the roll, Y down its length. Units are
           plan units; the SVG scales to the container.

           Y=0 is the starting end of the roll — a full, uncut, straight edge — and the roll
           carries on past the last cut. ContinuesDown picks which way that surplus is drawn,
           so the picture can match how the roll is actually lying in front of you. *@
        <svg viewBox="@ViewBox"
             preserveAspectRatio="xMidYMid meet"
             role="img"
             aria-label="@AriaLabel">

            <defs>
                <pattern id="@HatchId" width="6" height="6" patternUnits="userSpaceOnUse"
                         patternTransform="rotate(45)">
                    <rect width="6" height="6" fill="#fbfaf7" />
                    <line x1="0" y1="0" x2="0" y2="6" stroke="#dedad0" stroke-width="2" />
                </pattern>

                @for (int i = 0; i < Plan.Sections.Count; i++)
                {
                    CutSection clipped = Plan.Sections[i];
                    <clipPath id="@ClipId(i)">
                        <rect x="@N(clipped.X)" y="@N(DisplayY(clipped))"
                              width="@N(clipped.Width)" height="@N(clipped.Length)" />
                    </clipPath>
                }
            </defs>

            <text class="edge-label" x="@N(Plan.RollWidth / 2)" y="@N(StartLabelY)"
                  text-anchor="middle" dominant-baseline="middle" font-size="@N(HeadFont)">
                Start of roll
            </text>

            @* The paper consumed by this plan. *@
            <rect class="paper" x="0" y="0"
                  width="@N(Plan.RollWidth)" height="@N(Plan.RollLengthUsed)" />

            @for (int i = 0; i < Plan.Sections.Count; i++)
            {
                CutSection section = Plan.Sections[i];
                double centreX = section.X + (section.Width / 2);
                double centreY = DisplayY(section) + (section.Length / 2);

                <g class="cut">
                    <rect x="@N(section.X)" y="@N(DisplayY(section))"
                          width="@N(section.Width)" height="@N(section.Length)" />

                    <text x="@N(centreX)" y="@N(centreY)"
                          clip-path="url(#@ClipId(i))"
                          text-anchor="middle" dominant-baseline="middle"
                          font-size="@N(FontSize(section))">
                        <tspan x="@N(centreX)" dy="-0.55em">@section.ItemName</tspan>
                        <tspan x="@N(centreX)" dy="1.15em">@Dimensions(section)</tspan>
                    </text>
                </g>
            }

            @* Paper beyond the last cut: the roll is not used up. *@
            <rect class="continues" x="0" y="@N(BandY)"
                  width="@N(Plan.RollWidth)" height="@N(Band)" fill="url(#@HatchId)" />

            <text class="edge-label" x="@N(Plan.RollWidth / 2)" y="@N(BandY + (Band / 2))"
                  text-anchor="middle" dominant-baseline="middle" font-size="@N(BandFont)">
                @BandLabel
            </text>
        </svg>

        <figcaption class="text-muted small mt-1">
            Paper: @F(Plan.RollWidth) @UnitLabel wide × @F(Plan.RollLengthUsed) @UnitLabel long.
            The roll continues past the @(ContinuesDown ? "bottom" : "top") edge — the hatched
            area is paper you still have.
        </figcaption>
    </figure>
}

@code {
    [Parameter, EditorRequired]
    public WrapPlan Plan { get; set; } = default!;

    /// <summary>Which way the unused paper is drawn. Does not change the plan itself.</summary>
    [Parameter]
    public bool ContinuesDown { get; set; } = true;

    private string _uid = string.Empty;

    protected override void OnInitialized() => _uid = Guid.NewGuid().ToString("N")[..8];

    // Margins for the two annotations, sized relative to the roll so they scale with the
    // drawing rather than being fixed pixel amounts.
    private double Head => Plan.RollWidth * 0.10;

    private double Band => Plan.RollWidth * 0.18;

    private double HeadFont => Head * 0.55;

    private double BandFont => Band * 0.32;

    private double TopMargin => ContinuesDown ? Head : Band;

    private double BottomMargin => ContinuesDown ? Band : Head;

    private double BandY => ContinuesDown ? Plan.RollLengthUsed : -Band;

    private double StartLabelY => ContinuesDown ? -Head / 2 : Plan.RollLengthUsed + (Head / 2);

    private string BandLabel => ContinuesDown ? "↓ Roll continues" : "↑ Roll continues";

    private string ViewBox =>
        $"0 {@N(-TopMargin)} {@N(Plan.RollWidth)} {@N(TopMargin + Plan.RollLengthUsed + BottomMargin)}";

    /// <summary>
    /// Vertical position of a section in the drawing. The plan always measures Y from the
    /// starting end; when the surplus is drawn above, the used paper is mirrored so the
    /// starting edge stays adjacent to the "start" label.
    /// </summary>
    private double DisplayY(CutSection section) =>
        ContinuesDown ? section.Y : Plan.RollLengthUsed - (section.Y + section.Length);

    private string UnitLabel => Plan.Unit == LengthUnit.Centimeters ? "cm" : "in";

    private string AriaLabel =>
        $"Cut layout for {Plan.Sections.Count} sheet(s) on paper "
        + $"{F(Plan.RollWidth)} by {F(Plan.RollLengthUsed)} {UnitLabel}. "
        + $"Unused paper continues {(ContinuesDown ? "below" : "above")} the last cut.";

    private string HatchId => $"{_uid}-hatch";

    private string Dimensions(CutSection section) =>
        $"{F(section.Width)} × {F(section.Length)} {UnitLabel}";

    private string ClipId(int index) => $"{_uid}-{index}";

    /// <summary>
    /// Sized so two lines fit the rectangle: bounded by its height (two lines of text) and by
    /// its width (the longer of the two strings). A very small cut cannot show a label
    /// legibly — the clip path stops it spilling outside the rectangle.
    /// </summary>
    private double FontSize(CutSection section)
    {
        int longest = Math.Max(section.ItemName.Length, Dimensions(section).Length);
        double byWidth = longest > 0 ? section.Width / (longest * 0.62) : section.Width;
        double byHeight = Math.Min(section.Width, section.Length) * 0.30;
        double floor = Plan.RollWidth * 0.005;

        return Math.Max(Math.Min(byWidth, byHeight), floor);
    }

    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string F(double value) => value.ToString("F1", CultureInfo.InvariantCulture);
}
