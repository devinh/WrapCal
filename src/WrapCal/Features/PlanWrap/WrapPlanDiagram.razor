@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (Plan.Sections.Count == 0 || Plan.RollWidth <= 0 || Plan.RollLengthUsed <= 0)
{
    <MudText Typo="Typo.body2" Class="mb-0">Nothing to draw — no boxes to wrap.</MudText>
}
else
{
    <figure class="wrap-diagram mb-0" @ref="_figure">
        @* A section's plan coordinates are fixed — X across the roll, Y from the starting end.
           Direction only decides how those are laid out on the page, so the drawing can face
           whichever way the roll is actually lying in front of you.

           For Left/Right the roll runs horizontally, so a section's width and length swap on
           screen and the edge labels are rotated to fit the narrow side margins.

           The scroller keeps the drawing at a fixed scale along the roll — more boxes make it
           longer, never smaller — and opens on the origin. Re-keying the scroller is what puts
           it back on the origin: a new plan, or a new direction, starts scrolled afresh. *@
        @* Focusable because it scrolls by keyboard, and named because a focusable region with
           no accessible name is an unlabeled stop on the tab path. *@
        <div class="@ScrollerClass" tabindex="0" role="region" aria-label="Cut layout"
             style="@($"--diagram-zoom: {_zoomPercent / 100.0:0.###}")"
             @key="(Plan, Direction)">
            <svg viewBox="@ViewBox"
                 preserveAspectRatio="xMinYMin meet"
                 role="img"
                 data-testid="diagram"
                 aria-label="@AriaLabel">

                <defs>
                    <pattern id="@HatchId" width="6" height="6" patternUnits="userSpaceOnUse"
                             patternTransform="rotate(45)">
                        <rect class="hatch-background" width="6" height="6" />
                        <line class="hatch-line" x1="0" y1="0" x2="0" y2="6" />
                    </pattern>

                    @for (int i = 0; i < Plan.Sections.Count; i++)
                    {
                        Box clipped = Rect(Plan.Sections[i]);
                        <clipPath id="@ClipId(i)">
                            <rect x="@N(clipped.X)" y="@N(clipped.Y)"
                                  width="@N(clipped.W)" height="@N(clipped.H)" />
                        </clipPath>
                    }
                </defs>
                <g class="drawing">

                <text class="edge-label" x="@N(StartLabelX)" y="@N(StartLabelY)"
                      transform="@LabelTransform(StartLabelX, StartLabelY)"
                      text-anchor="middle" dominant-baseline="middle" font-size="@N(HeadFont)">
                    Start of roll
                </text>

                @* The plan's origin: the corner where X across the roll and Y along it are both
                   zero. Which corner that is depends on how the drawing is turned. *@
                <circle class="origin-dot" cx="@N(OriginX)" cy="@N(OriginY)" r="@N(OriginRadius)" />

                <text class="origin-label" x="@N(OriginLabelX)" y="@N(OriginLabelY)"
                      transform="@LabelTransform(OriginLabelX, OriginLabelY)"
                      text-anchor="start" dominant-baseline="middle" font-size="@N(OriginFont)">
                    0,0
                </text>

                @* The paper consumed by this plan. *@
                <rect class="paper" x="0" y="0" width="@N(PaperWidth)" height="@N(PaperHeight)" />

                @for (int i = 0; i < Plan.Sections.Count; i++)
                {
                    CutSection section = Plan.Sections[i];
                    Box box = Rect(section);
                    double centerX = box.X + (box.W / 2);
                    double centerY = box.Y + (box.H / 2);

                    <g class="cut">
                        <rect x="@N(box.X)" y="@N(box.Y)" width="@N(box.W)" height="@N(box.H)" />

                        <text x="@N(centerX)" y="@N(centerY)"
                              clip-path="url(#@ClipId(i))"
                              text-anchor="middle" dominant-baseline="middle"
                              font-size="@N(FontSize(section))">
                            <tspan x="@N(centerX)" dy="-0.55em">@section.ItemName</tspan>
                            <tspan x="@N(centerX)" dy="1.15em">@Dimensions(section)</tspan>
                        </text>
                    </g>
                }

                @* Paper beyond the last cut: the roll is not used up. *@
                <rect class="continues" x="@N(BandBox.X)" y="@N(BandBox.Y)"
                      width="@N(BandBox.W)" height="@N(BandBox.H)" fill="url(#@HatchId)" />

                <text class="edge-label" x="@N(BandLabelX)" y="@N(BandLabelY)"
                      transform="@LabelTransform(BandLabelX, BandLabelY)"
                      text-anchor="middle" dominant-baseline="middle" font-size="@N(BandFont)">
                    @BandLabel
                </text>
                </g>
            </svg>
        </div>

        <figcaption class="wrapcal-caption">
            Paper: @F(PaperWidth) @UnitLabel wide × @F(PaperHeight) @UnitLabel long.
            The dot marks the origin (0,0), where the distance across the roll and the distance
            along it are both zero. The roll continues past the @EdgeName edge — the hatched
            area is paper you still have.
            Zoom <span data-testid="zoom-level">@ZoomLabel</span> — Ctrl+scroll or pinch to zoom.
        </figcaption>
    </figure>
}

@code {
    [Parameter, EditorRequired]
    public WrapPlan Plan { get; set; } = default!;

    /// <summary>Which way the drawing faces. Does not change the plan itself.</summary>
    [Parameter]
    public RollDirection Direction { get; set; } = RollDirection.Up;

    private readonly record struct Box(double X, double Y, double W, double H);

    // Zoom is a percentage of the scale the roll width gives the drawing. 100 is the default and
    // the only value at which "the drawing never shrinks to fit" is being claimed. It is continuous
    // rather than stepped, so a trackpad's stream of small deltas glides the way a map does.
    private const double MinZoomPercent = 25;
    private const double MaxZoomPercent = 400;

    /// <summary>One notch of a mouse wheel. A trackpad sends smaller deltas that scale by less.</summary>
    private const double WheelNotch = 120;

    /// <summary>
    /// How much one notch's worth of delta (120) changes the scale: a ratio, so zooming out undoes
    /// zooming in.
    /// </summary>
    private const double ZoomPerNotch = 1.5;

    /// <summary>
    /// What a reported finger spread is raised to. Safari reports the spread itself, where Chrome
    /// and Firefox report far gentler pixel deltas, so a spread of 2 zooms 2 in Safari and about
    /// 1.2 elsewhere. Damping it to a root is what makes the three agree; the drawing then zooms
    /// less than the fingers spread, which is the compromise chosen over speeding up the two
    /// browsers whose feel is the reference.
    /// </summary>
    private const double GestureDamping = 0.5;

    private string _uid = string.Empty;

    private double _zoomPercent = 100;

    // What a pinch started at, so the ratio it reports applies to the zoom it began from rather
    // than compounding on every event.
    private double _gestureBaseZoomPercent = 100;

    // True between gesturestart and gestureend. Safari reports a pinch as gesture events while
    // Chromium and Firefox report it as ctrl+wheel; if a browser ever reports both, honouring both
    // would apply the pinch twice and zoom further there than anywhere else.
    private bool _gestureActive;

    // Set when a zoom is applied, so the render that follows can put the pointer's point back
    // under the pointer. Cleared once that has happened.
    private bool _zoomApplied;

    private ElementReference _figure;
    private DotNetObjectReference<WrapPlanDiagram>? _self;
    private bool _listening;

    private bool HasDrawing =>
        Plan.Sections.Count > 0 && Plan.RollWidth > 0 && Plan.RollLengthUsed > 0;

    protected override void OnInitialized() => _uid = Guid.NewGuid().ToString("N")[..8];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Attached to the figure rather than the scroller: the scroller is re-keyed whenever the
        // plan or the direction changes, which would take the listener with it. Wheel and gesture
        // events bubble, so one listener on the parent outlives every re-key.
        if (!HasDrawing)
        {
            return;
        }

        if (!_listening)
        {
            _self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("wrapcalDiagram.attach", _figure, _self);
            _listening = true;
            return;
        }

        if (_zoomApplied)
        {
            // After the render, so the drawing is measured at its new size: the point a gesture
            // started on goes back under the pointer.
            _zoomApplied = false;
            await Js.InvokeVoidAsync("wrapcalDiagram.anchor", _figure);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_listening)
        {
            await Js.InvokeVoidAsync("wrapcalDiagram.detach", _figure);
            _listening = false;
        }

        _self?.Dispose();
    }

    // Everything below arrives from JS, so it runs on a thread that is not the renderer's: the
    // state change and the re-render it needs both have to go through the dispatcher, or rendering
    // throws. InvokeAsync is how a component marshals onto it.

    [JSInvokable]
    public Task ZoomByWheelAsync(double deltaY) => InvokeAsync(() =>
    {
        // A pinch in progress is the authority; a wheel alongside it would double it up.
        if (_gestureActive)
        {
            return;
        }

        // Wheel up is a negative delta and should zoom in. A ratio per notch means a trackpad's
        // smaller deltas scale by less, which is what makes it smooth; nothing accumulates.
        ApplyZoom(_zoomPercent * Math.Pow(ZoomPerNotch, -deltaY / WheelNotch));
    });

    [JSInvokable]
    public Task BeginZoomGestureAsync() => InvokeAsync(() =>
    {
        _gestureActive = true;
        _gestureBaseZoomPercent = _zoomPercent;
    });

    [JSInvokable]
    public Task ZoomByRatioAsync(double ratio) => InvokeAsync(() =>
        ApplyZoom(_gestureBaseZoomPercent * Math.Pow(Math.Max(ratio, 0.01), GestureDamping)));

    [JSInvokable]
    public Task EndZoomGestureAsync() => InvokeAsync(() => _gestureActive = false);

    private void ApplyZoom(double percent)
    {
        double clamped = Math.Clamp(percent, MinZoomPercent, MaxZoomPercent);

        // A gesture can land on the clamp repeatedly; re-rendering for a change of nothing would
        // redraw the whole drawing for each event of the stream.
        if (Math.Abs(clamped - _zoomPercent) < 0.01)
        {
            return;
        }

        _zoomPercent = clamped;
        _zoomApplied = true;
        StateHasChanged();
    }

    private string ZoomLabel => $"{Math.Round(_zoomPercent):0}%";

    private bool IsHorizontal => Direction is RollDirection.Left or RollDirection.Right;

    /// <summary>
    /// The scroll axis follows the roll, and <c>is-reversed</c> marks the directions whose origin
    /// sits at the far end — laying the scroller out from that end is what makes it open there.
    /// </summary>
    private string ScrollerClass
    {
        get
        {
            string axis = IsHorizontal ? "is-horizontal" : "is-vertical";
            bool reversed = Direction is RollDirection.Up or RollDirection.Left;

            return reversed ? $"diagram-scroller {axis} is-reversed" : $"diagram-scroller {axis}";
        }
    }

    // Extents of the paper as drawn, which swap when the roll runs horizontally.
    private double PaperWidth => IsHorizontal ? Plan.RollLengthUsed : Plan.RollWidth;

    private double PaperHeight => IsHorizontal ? Plan.RollWidth : Plan.RollLengthUsed;

    // Margins for the two annotations, sized relative to the roll so they scale with the
    // drawing rather than being fixed pixel amounts.
    private double HeadThickness => Plan.RollWidth * 0.10;

    private double BandThickness => Plan.RollWidth * 0.18;

    private double HeadFont => HeadThickness * 0.55;

    private double BandFont => BandThickness * 0.32;

    // Breathing room between the paper and the frame, measured from the roll's width so it scales
    // with the drawing. Without it the roll's edges sit flush against the diagram's border, which
    // reads as being zoomed in too far.
    private double Gutter => Plan.RollWidth * 0.15;

    // The margins carry the two end annotations. They run along the roll, so the other axis — the
    // one the roll spans — is free for the gutter.
    private double LeftMargin => IsHorizontal
        ? (Direction == RollDirection.Left ? BandThickness : HeadThickness)
        : Gutter;

    private double RightMargin => IsHorizontal
        ? (Direction == RollDirection.Right ? BandThickness : HeadThickness)
        : Gutter;

    private double TopMargin => IsHorizontal
        ? Gutter
        : (Direction == RollDirection.Up ? BandThickness : HeadThickness);

    private double BottomMargin => IsHorizontal
        ? Gutter
        : (Direction == RollDirection.Down ? BandThickness : HeadThickness);

    private string ViewBox =>
        $"{N(-LeftMargin)} {N(-TopMargin)} "
        + $"{N(PaperWidth + LeftMargin + RightMargin)} {N(PaperHeight + TopMargin + BottomMargin)}";

    /// <summary>Where a section's rectangle lands on the page for the current direction.</summary>
    private Box Rect(CutSection section) => Direction switch
    {
        RollDirection.Down => new Box(section.X, section.Y, section.Width, section.Length),
        RollDirection.Up => new Box(
            section.X,
            Plan.RollLengthUsed - (section.Y + section.Length),
            section.Width,
            section.Length),
        // Horizontal layouts also flip X to Y downwards, so plan X = 0 sits along the bottom
        // edge and the origin lands at a bottom corner.
        RollDirection.Right => new Box(
            section.Y,
            Plan.RollWidth - (section.X + section.Width),
            section.Length,
            section.Width),
        RollDirection.Left => new Box(
            Plan.RollLengthUsed - (section.Y + section.Length),
            Plan.RollWidth - (section.X + section.Width),
            section.Length,
            section.Width),
        _ => throw new ArgumentOutOfRangeException(nameof(Direction)),
    };

    private Box BandBox => Direction switch
    {
        RollDirection.Down => new Box(0, Plan.RollLengthUsed, Plan.RollWidth, BandThickness),
        RollDirection.Up => new Box(0, -BandThickness, Plan.RollWidth, BandThickness),
        RollDirection.Right => new Box(Plan.RollLengthUsed, 0, BandThickness, Plan.RollWidth),
        RollDirection.Left => new Box(-BandThickness, 0, BandThickness, Plan.RollWidth),
        _ => throw new ArgumentOutOfRangeException(nameof(Direction)),
    };

    private double StartLabelX => Direction switch
    {
        RollDirection.Right => -HeadThickness / 2,
        RollDirection.Left => Plan.RollLengthUsed + (HeadThickness / 2),
        _ => Plan.RollWidth / 2,
    };

    private double StartLabelY => Direction switch
    {
        RollDirection.Down => -HeadThickness / 2,
        RollDirection.Up => Plan.RollLengthUsed + (HeadThickness / 2),
        _ => Plan.RollWidth / 2,
    };

    private double BandLabelX => Direction switch
    {
        RollDirection.Right => Plan.RollLengthUsed + (BandThickness / 2),
        RollDirection.Left => -BandThickness / 2,
        _ => Plan.RollWidth / 2,
    };

    private double BandLabelY => Direction switch
    {
        RollDirection.Down => Plan.RollLengthUsed + (BandThickness / 2),
        RollDirection.Up => -BandThickness / 2,
        _ => Plan.RollWidth / 2,
    };

    // The origin sits on the corner where plan X and plan Y are both zero. The mirror (Up) and
    // the transpose (Left/Right) each move it to a different corner of the paper. Which corner
    // that is comes from RollDirectionText, which the Cut Plan also names in words — so the
    // sentence and the dot cannot drift apart.
    private double OriginX => RollDirectionText.OriginAtFarEnd(Direction) ? Plan.RollLengthUsed : 0;

    private double OriginY => !RollDirectionText.OriginAtBottom(Direction)
        ? 0
        : IsHorizontal ? Plan.RollWidth : Plan.RollLengthUsed;

    private double OriginRadius => Plan.RollWidth * 0.012;

    private double OriginPad => Plan.RollWidth * 0.01;

    // Smaller than the edge labels: it is a marker, not a caption.
    private double OriginFont => HeadThickness * 0.40;

    private double OriginLabelX => Direction switch
    {
        RollDirection.Right => -HeadThickness * 0.55,
        RollDirection.Left => Plan.RollLengthUsed + (HeadThickness * 0.55),
        _ => OriginPad,
    };

    // Anchored "start" in every direction: on the rotated side labels that makes the text run
    // up into the drawing from the bottom corner, instead of out of the viewBox.
    private double OriginLabelY => Direction switch
    {
        RollDirection.Down => -HeadThickness * 0.55,
        RollDirection.Up => Plan.RollLengthUsed + (HeadThickness * 0.55),
        _ => Plan.RollWidth - OriginPad,
    };

    // The side labels are rotated -90 degrees, and an arrow glyph turns a quarter turn with the
    // text it sits in. So a "down" glyph renders pointing right, and an "up" glyph renders
    // pointing left — the glyphs below are chosen for how they end up, not how they read here.
    private string BandLabel => Direction switch
    {
        RollDirection.Down => "↓ Roll continues",
        RollDirection.Up => "↑ Roll continues",
        RollDirection.Right => "↓ Roll continues",
        _ => "↑ Roll continues",
    };

    private string EdgeName => RollDirectionText.EdgeWord(Direction);

    /// <summary>
    /// Side labels are rotated on horizontal layouts: the margin is only a fraction of the roll
    /// width, so horizontal text would run far outside it.
    /// </summary>
    private string? LabelTransform(double centerX, double centerY) =>
        IsHorizontal ? $"rotate(-90 {N(centerX)} {N(centerY)})" : null;

    private string UnitLabel => Plan.Unit == LengthUnit.Centimeters ? "cm" : "in";

    private string AriaLabel =>
        $"Cut layout for {Plan.Sections.Count} sheet(s) on paper "
        + $"{F(PaperWidth)} by {F(PaperHeight)} {UnitLabel}. "
        + $"The origin is marked at the corner where both distances are zero. "
        + $"Unused paper continues past the {EdgeName} edge.";

    private string HatchId => $"{_uid}-hatch";

    private string Dimensions(CutSection section) =>
        $"{F(section.Width)} × {F(section.Length)} {UnitLabel}";

    private string ClipId(int index) => $"{_uid}-{index}";

    /// <summary>
    /// Sized so two lines fit the rectangle: bounded by its height (two lines of text) and by
    /// its width (the longer of the two strings). A very small cut cannot show a label
    /// legibly — the clip path stops it spilling outside the rectangle.
    /// </summary>
    private double FontSize(CutSection section)
    {
        Box box = Rect(section);
        int longest = Math.Max(section.ItemName.Length, Dimensions(section).Length);
        double byWidth = longest > 0 ? box.W / (longest * 0.62) : box.W;
        double byHeight = Math.Min(box.W, box.H) * 0.30;
        double floor = Plan.RollWidth * 0.005;

        return Math.Max(Math.Min(byWidth, byHeight), floor);
    }

    // Normalizing zero keeps "-0" out of the viewBox when a margin is zero.
    private static string N(double value) =>
        (value == 0 ? 0d : value).ToString("0.###", CultureInfo.InvariantCulture);

    // Text the reader sees, so it follows their culture; N() stays invariant because it writes
    // SVG attributes, which only parse with a decimal point.
    private static string F(double value) => value.ToString("F1", CultureInfo.CurrentCulture);
}
