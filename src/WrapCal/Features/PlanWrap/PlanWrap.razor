@page "/"

<PageTitle>Wrapping Paper Planner</PageTitle>

@* HtmlTag makes this a real h1 rather than a styled p — the page had no heading element at
   all, so Router's FocusOnNavigate had nothing to move focus to. *@
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Wrapping Paper Planner</MudText>

<MudText Typo="Typo.body1" Class="mb-6">
    Tell it the roll you have and the boxes you want to wrap. It works out the sheet each box
    needs, where to cut, and how much of the roll is left over.
</MudText>

<MudForm @ref="_form" Model="_input">
    <MudGrid Spacing="3" Class="mb-6" data-testid="roll-options">
        <MudItem xs="12" md="4">
            <MudNumericField T="double" Label="Roll Width"
                             @bind-Value="_input.RollWidth"
                             @bind-Value:after="DiscardPlan"
                             For="() => _input.RollWidth"
                             Validation="RollWidthValidation"
                             HelperText="Usable width of the roll — across it, not its length."
                             data-testid="roll-width" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudNumericField T="double" Label="Overlap Margin"
                             @bind-Value="_input.OverlapMargin"
                             @bind-Value:after="DiscardPlan"
                             For="() => _input.OverlapMargin"
                             Validation="OverlapValidation"
                             HelperText="How far the two paper ends overlap at the seam."
                             data-testid="overlap-margin" />
        </MudItem>

        <MudItem xs="12" md="4">
            @* MudSelect puts unmatched attributes on its hidden input, which cannot be clicked,
               so the testid wraps it instead — the suite opens the picker through this. *@
            <div data-testid="unit-select">
                <MudSelect T="LengthUnit" Label="Units"
                           @bind-Value="_input.InputUnit"
                           @bind-Value:after="OnUnitChangedAsync"
                           HelperText="Used for what you type in and what you get back.">
                    <MudSelectItem Value="LengthUnit.Inches">Inches</MudSelectItem>
                    <MudSelectItem Value="LengthUnit.Centimeters">Centimetres</MudSelectItem>
                </MudSelect>
            </div>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-1">Boxes</MudText>

    <MudText Typo="Typo.body2" Class="mb-3">
        Length, width and height of each box, in the units selected above. The planner wraps
        each box in a single sheet, folding the paper over both ends.
    </MudText>

    <MudPaper Elevation="1" Class="pa-4 mb-4" data-testid="boxes">
        @for (int row = 0; row < _input.Boxes.Count; row++)
        {
            int index = row;
            // Captured into a local: the loop variable is not safe to use in a closure.
            BoxInput box = _input.Boxes[index];
            string placeholder = $"Box {index + 1}";

            <MudGrid Spacing="2" Class="align-center mb-2" data-testid="box-row">
                <MudItem xs="12" sm="4" md="4">
                    <MudTextField T="string" Label="Name" Placeholder="@placeholder"
                                  @bind-Value="box.Name"
                                  @bind-Value:after="DiscardPlan"
                                  For="() => box.Name"
                                  Validation="NameValidation"
                                  data-testid="box-name"
                                  HelperText=" " Class="wrapcal-message-slot" />
                </MudItem>

                <MudItem xs="3" sm="2" md="2">
                    <MudNumericField T="double" Label="Length"
                                     @bind-Value="box.Length"
                                     @bind-Value:after="DiscardPlan"
                                     For="() => box.Length"
                                     Validation="LengthValidation"
                                     data-testid="box-length"
                                     HelperText=" " Class="wrapcal-message-slot" />
                </MudItem>

                <MudItem xs="3" sm="2" md="2">
                    <MudNumericField T="double" Label="Width"
                                     @bind-Value="box.Width"
                                     @bind-Value:after="DiscardPlan"
                                     For="() => box.Width"
                                     Validation="WidthValidation"
                                     data-testid="box-width"
                                     HelperText=" " Class="wrapcal-message-slot" />
                </MudItem>

                <MudItem xs="3" sm="2" md="2">
                    <MudNumericField T="double" Label="Height"
                                     @bind-Value="box.Height"
                                     @bind-Value:after="DiscardPlan"
                                     For="() => box.Height"
                                     Validation="HeightValidation"
                                     data-testid="box-height"
                                     HelperText=" " Class="wrapcal-message-slot" />
                </MudItem>

                @* Sits on the line of the inputs rather than the centre of the field: a Mud field is
                   taller than its input by the floating label above it and the reserved message line
                   below, so a button centred on the control hangs about 16px below the inputs.

                   Full width on a phone gave it a line of its own under the row, which read as a
                   stray button floating in whitespace. It now sits at the end of the dimensions
                   instead: the Name takes the first line by itself and the three fields plus the
                   button share the second, and from sm up all five share one. *@
                <MudItem xs="3" sm="2" md="2" Class="d-flex justify-end"
                         Style="align-self: flex-start; margin-top: 0.5rem">
                    @* Named for its row: every button saying "Remove this box" gives a screen
                       reader no way to tell one row's button from another's. *@
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   aria-label="@($"Remove {placeholder}")"
                                   data-testid="remove-box"
                                   Disabled="@(_input.Boxes.Count <= 1)"
                                   OnClick="() => RemoveBox(index)" />
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <MudStack Row="true" Spacing="2" Class="mb-6">
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Add"
                   data-testid="add-box"
                   Disabled="@(_input.Boxes.Count >= PlanWrapInput.MaxBoxCount)"
                   OnClick="AddBox">
            Add box
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   data-testid="plan-button"
                   OnClick="SubmitAsync">
            Plan
        </MudButton>
    </MudStack>
</MudForm>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="plan-error">@_error</MudAlert>
}

@if (_plan is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Paper Layout</MudText>

            @* Presentation only — it changes which way the drawing faces, not the plan. *@
            <div data-testid="roll-direction">
                @* A width of its own: left to size itself the select takes the width of whichever
                   option is showing, and Mud sizes the popover from the anchor — so picking "Top"
                   left "Bottom" clipped in the menu. *@
                <MudSelect T="RollDirection" Label="Roll Orientation" Dense="true"
                           Style="min-width: 11rem"
                           @bind-Value="_rollDirection">
                    @* Named for the side the roll is on, which is what it says on the drawing. The
                       words come from RollDirectionText so the menu, the caption and the Cut Plan
                       line cannot end up saying different things. *@
                    @foreach (RollDirection option in RollDirectionText.MenuOrder)
                    {
                        <MudSelectItem Value="option">@RollDirectionText.MenuLabel(option)</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudStack>

        <WrapPlanDiagram Plan="_plan" Direction="_rollDirection" />
    </MudPaper>

    <WrapPlanView Plan="_plan" Direction="_rollDirection" />
}
