@using System.Globalization

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" Class="mb-3">Cut Plan</MudText>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Roll Length Used</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="roll-length">@Format(Plan.RollLengthUsed)</span> @UnitLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Paper Cut</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="paper-area">@Format(Plan.PaperAreaCut)</span> @AreaLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Waste</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="waste-area">@Format(Plan.WasteArea)</span> @AreaLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Efficiency</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="efficiency">@Plan.Efficiency.ToString("P1", CultureInfo.InvariantCulture)</span>
            </MudText>
        </MudItem>
    </MudGrid>

    <table class="wrapcal-sections" data-testid="sections">
        <thead>
            <tr>
                <th scope="col">Item</th>
                <th scope="col">X</th>
                <th scope="col">Y</th>
                <th scope="col">Width</th>
                <th scope="col">Length</th>
                <th scope="col">Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CutSection section in Plan.Sections)
            {
                <tr>
                    <td>@section.ItemName</td>
                    <td>@Format(section.X)</td>
                    <td>@Format(section.Y)</td>
                    <td>@Format(section.Width)</td>
                    <td>@Format(section.Length)</td>
                    <td class="wrapcal-note">@section.Note</td>
                </tr>
            }
        </tbody>
    </table>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public WrapPlan Plan { get; set; } = default!;

    private string UnitLabel => Plan.Unit == LengthUnit.Centimeters ? "cm" : "in";

    private string AreaLabel => Plan.Unit == LengthUnit.Centimeters ? "cm²" : "in²";

    private static string Format(double value) => value.ToString("F1", CultureInfo.InvariantCulture);
}
