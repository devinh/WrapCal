@using System.Globalization

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" Class="mb-1">Cut Plan</MudText>

    @* Names what the table cannot say: which way the drawing runs, and the corner X and Y are
       counted from. The words come from RollDirectionText, which also places the origin dot. *@
    <MudText Typo="Typo.body2" Class="mb-3 wrapcal-orientation" data-testid="plan-orientation">
        @OrientationLine
    </MudText>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Roll Length Used</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="roll-length">@Format(Plan.RollLengthUsed)</span> @UnitLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Paper Cut</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="paper-area">@Format(Plan.PaperAreaCut)</span> @AreaLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Waste</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="waste-area">@Format(Plan.WasteArea)</span> @AreaLabel
            </MudText>
        </MudItem>

        <MudItem xs="6" md="3">
            <MudText Typo="Typo.caption">Efficiency</MudText>
            <MudText Typo="Typo.h5">
                <span data-testid="efficiency">@Plan.Efficiency.ToString("P1", CultureInfo.CurrentCulture)</span>
            </MudText>
        </MudItem>
    </MudGrid>

    @* The scroller keeps the table inside the card. Six columns of numbers plus a prose Note
       have a minimum content width wider than a phone, and a table cannot shrink below it — it
       spilled out over the card's edge instead. *@
    <div class="wrapcal-table-scroll">
        <table class="wrapcal-sections" data-testid="sections">
            <thead>
                <tr>
                    <th scope="col">Item</th>
                    <th scope="col">X</th>
                    <th scope="col">Y</th>
                    <th scope="col">Width</th>
                    <th scope="col">Length</th>
                    <th scope="col">Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CutSection section in Plan.Sections)
                {
                    <tr>
                        <td>@section.ItemName</td>
                        <td>@Format(section.X)</td>
                        <td>@Format(section.Y)</td>
                        <td>@Format(section.Width)</td>
                        <td>@Format(section.Length)</td>
                        <td class="wrapcal-note">@section.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public WrapPlan Plan { get; set; } = default!;

    /// <summary>Which way the drawing runs. Presentation only — the plan is the same either way.</summary>
    [Parameter]
    public RollDirection Direction { get; set; } = RollDirection.Up;

    // One string rather than several lines of markup, so the spacing is exactly what is written
    // here instead of whatever the markup's indentation happens to produce.
    private string OrientationLine =>
        $"Roll orientation: {RollDirectionText.MenuLabel(Direction)} — the roll continues past the "
        + $"{RollDirectionText.EdgeWord(Direction)} edge. Origin (0,0): "
        + $"{RollDirectionText.OriginCorner(Direction)} corner.";

    private string UnitLabel => Plan.Unit == LengthUnit.Centimeters ? "cm" : "in";

    private string AreaLabel => Plan.Unit == LengthUnit.Centimeters ? "cm²" : "in²";

    // The culture the form's numeric fields parse in, so a figure here is spelled the same way
    // as the field it came from.
    private static string Format(double value) => value.ToString("F1", CultureInfo.CurrentCulture);
}
