<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Rewrites the #[.{fingerprint}] placeholders in wwwroot/index.html at publish time, so
         the boot script URL is content-addressed and the importmap is filled in. Without it the
         placeholders ship verbatim and the page never boots. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can pin which sheets a box may be cut to. That rule includes a sheet never
         being offered at all because another dominates it, which is otherwise only observable
         through a plan that happens not to use it — a much weaker claim. -->
    <InternalsVisibleTo Include="WrapCal.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <!-- Only so `dotnet run` and `dotnet watch` have something to serve the static files. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

</Project>
