@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Http
@inject IServiceProvider Services

<PageTitle>Error</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Error" Class="mb-2">Error.</MudText>
<MudText Typo="Typo.h6" Class="mb-4">An error occurred while processing your request.</MudText>

@if (ShowRequestId)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4">
        <MudText Typo="Typo.body2"><strong>Request ID:</strong> <code>@RequestId</code></MudText>
    </MudPaper>
}

<MudText Typo="Typo.h6" Class="mb-2">Development Mode</MudText>
<MudText Typo="Typo.body2" Class="mb-2">
    Swapping to <strong>Development</strong> environment will display more detailed information about
    the error that occurred.
</MudText>
<MudText Typo="Typo.body2">
    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
    It can result in displaying sensitive information from exceptions to end users. For local
    debugging, enable the <strong>Development</strong> environment by setting the
    <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
    and restarting the app.
</MudText>

@code {
    private const string PersistKey = "wrapcal-request-id";

    private PersistingComponentStateSubscription? _persisting;

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        // The trace identifier exists only while the request is in flight, and this page is
        // prerendered and then hydrated as a separate instance. Without the handoff the
        // interactive pass would come up with nothing and the one diagnostic on the page
        // would vanish exactly when someone needs it.
        // Resolved rather than injected: PersistentComponentState is only registered by a real
        // Razor host, and a page whose job is to render when things are broken should not throw
        // because the handoff service is the thing that went missing.
        PersistentComponentState? state =
            Services.GetService(typeof(PersistentComponentState)) as PersistentComponentState;

        RequestId = state is not null && state.TryTakeFromJson<string>(PersistKey, out string? persisted)
            ? persisted
            : Activity.Current?.Id ?? Http.HttpContext?.TraceIdentifier;

        _persisting = state?.RegisterOnPersisting(() =>
        {
            state.PersistAsJson(PersistKey, RequestId ?? string.Empty);
            return Task.CompletedTask;
        });
    }

    public void Dispose() => _persisting?.Dispose();
}
