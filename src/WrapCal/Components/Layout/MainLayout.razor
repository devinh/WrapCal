@inherits LayoutComponentBase

@* The providers live here because MainLayout renders inside the interactive tree that starts at
   <Routes> in App.razor. A MudSelect whose popover provider sits outside that tree reports a
   missing MudPopoverProvider and cannot open. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-3">WrapCal</MudText>
        <MudSpacer />
        <MudIconButton Icon="@ThemeIcon"
                       Color="Color.Inherit"
                       OnClick="ToggleThemeAsync"
                       data-testid="theme-toggle"
                       aria-label="Switch between light and dark theme" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
