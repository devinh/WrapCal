@inherits LayoutComponentBase

@* The providers live here because MainLayout renders inside the interactive tree that starts at
   <Routes> in App.razor. A MudSelect whose popover provider sits outside that tree reports a
   missing MudPopoverProvider and cannot open. *@
<MudThemeProvider @ref="_provider" Theme="_theme" IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-3">WrapCal</MudText>
        <MudSpacer />
        @* The icon shows what is in force, not what a click would do: with three choices a
           toggle no longer has an obvious opposite. The testid wraps the menu because MudMenu
           puts unmatched attributes on markup of its own choosing. *@
        <div data-testid="theme-menu">
            <MudMenu Icon="@ThemeIcon"
                     Color="Color.Inherit"
                     Dense="true"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     aria-label="@($"Theme: {ThemeLabel}")">
                <MudMenuItem OnClick="@(() => ChooseThemeAsync(ThemeChoice.System))" data-testid="theme-system">
                    System
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => ChooseThemeAsync(ThemeChoice.Light))" data-testid="theme-light">
                    Light
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => ChooseThemeAsync(ThemeChoice.Dark))" data-testid="theme-dark">
                    Dark
                </MudMenuItem>
            </MudMenu>
        </div>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
